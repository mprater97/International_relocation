{
  "manifest_version": 3,
  "name": "Domain Property Grabber",
  "version": "1.0",
  "description": "One-click save Domain.com.au listings to your relocation tracker",
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["https://www.domain.com.au/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
